# Supabase server configuration
# Required for customer pickup request storage and protected staff operations.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Optional build-time overrides when connecting this site to a different Supabase project.
# The current project has public URL/key fallbacks in vite.config.ts.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Required only when running Drizzle migrations from the CLI.
LOVABLE_DB_MIGRATION_URL=
