# Browser-visible Supabase project settings. These values are public identifiers,
# not credentials that grant database access.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Server runtime Supabase settings. Keep the service-role key server-only.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Optional private HMAC secret for pickup contact throttling. If unset, the server
# uses SUPABASE_SERVICE_ROLE_KEY as the HMAC key.
PICKUP_RATE_LIMIT_SECRET=

# Admin pickup notifications. EMAIL_FROM must be a sender verified in Resend.
RESEND_API_KEY=
ADMIN_NOTIFICATION_EMAIL=
EMAIL_FROM=

# Direct PostgreSQL connection used only by `npx drizzle-kit migrate`.
=======
# Required for customer pickup request storage. Keep this server-only.
SUPABASE_SERVICE_ROLE_KEY=

# Optional public project overrides when connecting this site to a different Supabase project.
# They are safe to expose and are shared by browser and server auth. Keep them paired.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Optional public canonical origin. Set to your verified custom domain at launch.
VITE_SITE_URL=https://umsp.vercel.app

